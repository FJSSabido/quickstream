<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<ScrollView
    android:id="@+id/scrollMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecera centrada, con el mismo estilo de título que El Soñadero:
             serif cursiva en negrita, amarillo luciérnaga. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="QuickStream"
            android:textColor="@color/state_on"
            android:textSize="40sp"
            android:textStyle="bold|italic" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="Tu cámara o tu pantalla, en directo con un enlace"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Tarjeta: Conexión. Oculta: el servidor, la sala y la contraseña se rellenan
             solos (servidor por defecto + sala aleatoria guardada), así quien usa la app
             solo ve la fuente, el audio y el enlace/QR. Se mantiene en el layout porque
             MainActivity sigue leyendo esos campos. -->
        <LinearLayout
            android:id="@+id/cardConnection"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Conexión"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="URL del servidor (ej: https://tu-servidor.onrender.com)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Sala"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRoomId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegenRoom"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="🎲" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Contraseña de la sala (opcional)"
                app:endIconMode="password_toggle"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Tarjeta: Fuente y audio, con botones grandes que cambian de color según su
             estado (encendido/apagado) y permiten cambiar EN CALIENTE, sin cortar la
             transmisión si ya está en marcha. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="Fuente y audio"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Cambia de cámara o micrófono sin cortar la emisión"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSourceFront"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:letterSpacing="0"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="🤳\nFrontal"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSourceBack"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:letterSpacing="0"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="📷\nTrasera"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSourceScreen"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:letterSpacing="0"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="🖥️\nPantalla"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleMic"
                android:letterSpacing="0"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="🎙️ Micrófono"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- Botón principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartStop"
            android:letterSpacing="0"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="22dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Iniciar transmisión"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="30dp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Desconectado"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Modo conversación: con la emisión en marcha, pegar el enlace de otra
             persona para verla y oírla aquí, con cancelación de eco (sin acople). -->
        <TextView
            android:id="@+id/btnConversation"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chat_hide"
            android:contentDescription="Conversar con otra persona"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="👥  Conversar con otra persona"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cardConversation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="Conversación"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/txtConversationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Imagen de la otra persona. Al maximizarla, esta misma caja se pasa a
                 conversationFullscreen (ver MainActivity.setConversationFullscreen). -->
            <FrameLayout
                android:id="@+id/remoteVideoFrame"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="10dp"
                android:background="#1a0b2e">

                <org.webrtc.SurfaceViewRenderer
                    android:id="@+id/remoteRenderer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- La otra persona no manda imagen (solo micrófono) o aún no llega. -->
                <TextView
                    android:id="@+id/txtRemoteAudioOnly"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#22103d"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="🎙️\nSolo sonido"
                    android:textColor="@color/state_on"
                    android:textSize="18sp"
                    android:textStyle="italic" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnRemoteMute"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_video_button"
                        android:contentDescription="Silenciar a la otra persona"
                        android:gravity="center"
                        android:text="🔊"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/btnRemoteFullscreen"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_video_button"
                        android:contentDescription="Ver a pantalla completa"
                        android:gravity="center"
                        android:text="⛶"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/btnEndConversation"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chat_hide"
                android:contentDescription="Terminar la conversación"
                android:gravity="center"
                android:paddingHorizontal="22dp"
                android:text="Terminar conversación"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tarjeta con la URL para compartir -->
        <LinearLayout
            android:id="@+id/cardShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <!-- Antes de emitir ya se ve el enlace que se va a usar (para poder
                 compartirlo con antelación); el dado crea uno nuevo para que cada
                 transmisión pueda tener su propia URL. Con la emisión en marcha el
                 dado se oculta: cambiar de sala cortaría a quien ya está viendo. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="Enlace de la emisión"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/txtViewerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/accent_light"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <!-- QR en los colores de la app, con marco amarillo -->
            <ImageView
                android:id="@+id/imgQr"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_qr"
                android:padding="14dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyUrl"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:text="Copiar"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    app:cornerRadius="26dp"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareUrl"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Compartir"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="26dp" />
            </LinearLayout>

            <!-- Antes de emitir: crea un enlace nuevo para esta transmisión. Con la
                 emisión en marcha se oculta (cambiar de sala cortaría a quien ya ve). -->
            <TextView
                android:id="@+id/btnNewLink"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chat_hide"
                android:contentDescription="Crear un enlace nuevo"
                android:gravity="center"
                android:paddingHorizontal="22dp"
                android:text="🎲  Enlace nuevo"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtViewerCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

    <!-- Chat en directo FLOTANTE (compartido: lo ven el anfitrión y todos los
         espectadores). Aparece encima de la pantalla en cuanto la emisión está en
         directo; con ⌄ se pliega y queda solo la burbuja 💬, que cuenta los mensajes
         nuevos sin leer. Mismo comportamiento que el chat de la web en el móvil. -->
    <LinearLayout
        android:id="@+id/cardChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_chat_float"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="Chat en directo"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/btnChatHide"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chat_hide"
                android:contentDescription="Ocultar chat"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Ocultar"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginEnd="6dp"
            android:overScrollMode="never"
            android:defaultFocusHighlightEnabled="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtChatEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:text="Todavía no hay mensajes."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/chatMessagesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Escribe un mensaje…"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputChatMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLength="500"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendChat"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:contentDescription="Enviar mensaje"
                android:text="➤"
                android:textSize="18sp"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Burbuja del chat plegado, con contador de mensajes sin leer. -->
    <FrameLayout
        android:id="@+id/chatFab"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnChatShow"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/bg_chat_fab"
            android:contentDescription="Mostrar chat"
            android:elevation="8dp"
            android:gravity="center"
            android:text="💬"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/txtChatUnread"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_unread_badge"
            android:elevation="9dp"
            android:gravity="center"
            android:minWidth="22dp"
            android:paddingHorizontal="6dp"
            android:textColor="@color/state_on_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Pantalla completa de la conversación: vacía y oculta hasta que se maximiza. -->
    <FrameLayout
        android:id="@+id/conversationFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:elevation="40dp"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>

